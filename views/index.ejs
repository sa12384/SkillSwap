
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SkillSwap - Learn. Share. Grow.</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- Navigation Bar -->
    <nav class="navbar">

        <div class="logo">
            Skill<span>Swap</span>
        </div>

       

<div class="nav-links">
    <a href="/">Home</a>
    <a href="/dashboard">Dashboard</a>
    <a href="/skills">Explore Skills</a>
    <a href="/find-students" class="active">Find Students</a>
    <a href="/requests">Requests</a>
    <a href="/profile">Profile</a>
    
</div>



    </nav>

    <!-- Hero Section -->
    <section class="hero">

        <div class="hero-content">

            <p class="small-title">PEER-TO-PEER LEARNING PLATFORM</p>

            <h1>
                Learn. Share.<br>
                <span>Grow Together.</span>
            </h1>

            <p class="hero-text">
                Connect with students who have the skills you want to
                learn and share the skills you already know.
            </p>

            <div class="hero-buttons">
                <a href="/skills" class="primary-btn">
                    Explore Skills
                </a>

                <a href="/register" class="secondary-btn">
                    Join SkillSwap
                </a>
            </div>

        </div>

        <div class="hero-card">

            <div class="card-icon">💡</div>

            <h3>Share What You Know</h3>

            <p>
                Turn your skills and knowledge into opportunities
                to help other students.
            </p>

            <div class="mini-stats">
                <div>
                    <strong>100+</strong>
                    <span>Skills</span>
                </div>

                <div>
                    <strong>50+</strong>
                    <span>Students</span>
                </div>
            </div>

        </div>

    </section>

    <!-- Popular Skills Section -->
    <section class="skills-section" id="skills">

        <div class="section-heading">

            <p class="small-title">DISCOVER</p>

            <h2>Popular Skills</h2>

            <p>
                Explore skills shared by students in the SkillSwap community.
            </p>

        </div>

        <div class="skills-grid">

            <div class="skill-card">
                <div class="skill-icon">💻</div>
                <h3>Programming</h3>
                <p>Learn coding and software development.</p>
            </div>

            <div class="skill-card">
                <div class="skill-icon">🎨</div>
                <h3>Graphic Design</h3>
                <p>Develop creative design skills.</p>
            </div>

            <div class="skill-card">
                <div class="skill-icon">📸</div>
                <h3>Photography</h3>
                <p>Learn photography techniques and editing.</p>
            </div>

            <div class="skill-card">
                <div class="skill-icon">🎤</div>
                <h3>Public Speaking</h3>
                <p>Build confidence in communication.</p>
            </div>

            <div class="skill-card">
                <div class="skill-icon">🎵</div>
                <h3>Music</h3>
                <p>Share and learn musical skills.</p>
            </div>

            <div class="skill-card">
                <div class="skill-icon">🌎</div>
                <h3>Languages</h3>
                <p>Learn and practice new languages.</p>
            </div>

        </div>

    </section>

    <!-- How It Works -->
    <section class="how-section" id="how-it-works">

        <div class="section-heading">

            <p class="small-title">SIMPLE PROCESS</p>

            <h2>How SkillSwap Works</h2>

            <p>
                Start learning and sharing in just a few simple steps.
            </p>

        </div>

        <div class="steps">

            <div class="step">
                <div class="step-number">01</div>

                <h3>Create Your Profile</h3>

                <p>
                    Tell the community about yourself,
                    your interests and your learning goals.
                </p>
            </div>

            <div class="step">
                <div class="step-number">02</div>

                <h3>Add Your Skills</h3>

                <p>
                    Add skills you can teach and skills
                    you would like to learn.
                </p>
            </div>

            <div class="step">
                <div class="step-number">03</div>

                <h3>Find a Skill Partner</h3>

                <p>
                    Search and discover students who
                    can help you learn.
                </p>
            </div>

            <div class="step">
                <div class="step-number">04</div>

                <h3>Start Learning</h3>

                <p>
                    Send an exchange request and
                    schedule your learning session.
                </p>
            </div>

        </div>

    </section>

    <!-- Call To Action -->
    <section class="cta">

        <h2>Ready to Start Learning?</h2>

        <p>
            Join SkillSwap and connect with students
            who are ready to learn and share.
        </p>

        <a href="/register" class="primary-btn">
            Get Started
        </a>

    </section>

    <!-- Footer -->
    <footer>

        <div class="footer-logo">
            Skill<span>Swap</span>
        </div>

        <p>
            Learn skills. Share knowledge. Grow together.
        </p>

        <p class="copyright">
            © 2026 SkillSwap. All rights reserved.
        </p>

    </footer>

</body>
</html>