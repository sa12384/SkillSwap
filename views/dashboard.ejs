            Learn skills. Share knowledge. Grow together.
        </p>

        <p class="copyright">
            © 2026 SkillSwap. All rights reserved.
        </p>

    </footer>

    <script>
    async function loadDashboardStats() {
        const token = localStorage.getItem('token');

        if (!token) {
            window.location.href = '/login';
            return;
        }

        try {
            const response = await fetch('/api/dashboard/stats', {
                headers: {
                    'Authorization': `Bearer ${token}`
                }
            });

            if (response.status === 401 || response.status === 403) {
                window.location.href = '/login';
                return;
            }

            if (!response.ok) {
                throw new Error('Failed to load dashboard statistics');
            }

            const data = await response.json();

            document.getElementById('skillsTeachCount').textContent =
                data.stats.skillsTeach;

            document.getElementById('skillsLearnCount').textContent =
                data.stats.skillsLearn;

            document.getElementById('pendingRequestsCount').textContent =
                data.stats.pendingRequests;

        } catch (error) {
            console.error('Dashboard statistics error:', error);
        }
    }

    async function loadDashboardSkills() {
        const token = localStorage.getItem('token');
        const skillsList = document.getElementById('dashboardSkillsList');

        if (!token) {
            window.location.href = '/login';
            return;
        }

        try {
            const response = await fetch('/api/skills/my-skills', {
                headers: {
                    'Authorization': `Bearer ${token}`
                }
            });

            if (response.status === 401 || response.status === 403) {
                window.location.href = '/login';
                return;
            }

            if (!response.ok) {
                throw new Error('Could not load skills');
            }

            const data = await response.json();
            const skills = data.skills || [];

            if (skills.length === 0) {
                skillsList.innerHTML = '<p>You have not added any skills yet.</p>';
                return;
            }

            skillsList.innerHTML = '';

            skills.forEach(skill => {
                const isTeaching = skill.skill_type === 'teach';

                const skillElement = document.createElement('div');
                skillElement.className = 'dashboard-skill';

                const symbol = document.createElement('div');
                symbol.className = 'skill-symbol';
                symbol.textContent = isTeaching ? '🎓' : '📚';

                const details = document.createElement('div');
                const name = document.createElement('h3');
                name.textContent = skill.skill_name;

                const label = document.createElement('span');
                label.className = isTeaching ? 'teach-label' : 'learn-label';
                label.textContent = isTeaching ? 'Teaching' : 'Learning';

                details.appendChild(name);
                details.appendChild(label);
                skillElement.appendChild(symbol);
                skillElement.appendChild(details);
                skillsList.appendChild(skillElement);
            });
        } catch (error) {
            console.error('Dashboard skills error:', error);
            skillsList.innerHTML = '<p>Could not load your skills. Please try again.</p>';
        }
    }

    async function loadRecentRequests() {
    const token = localStorage.getItem('token');
    const requestsList = document.getElementById('dashboardRequestsList');

    try {
        const response = await fetch('/api/dashboard/recent-requests', {
            headers: {
                'Authorization': `Bearer ${token}`
            }
        });

        if (!response.ok) {
            throw new Error('Could not load recent requests');
        }

        const data = await response.json();
        const requests = data.requests || [];

        if (requests.length === 0) {
            requestsList.innerHTML = '<p>You have no exchange requests yet.</p>';
            return;
        }

        requestsList.innerHTML = '';

        requests.forEach(request => {
            const item = document.createElement('div');
            item.className = 'request-item';

            const avatar = document.createElement('div');
            avatar.className = 'avatar';
            avatar.textContent = request.name
                .split(' ')
                .map(part => part[0])
                .join('')
                .substring(0, 2)
                .toUpperCase();

            const info = document.createElement('div');
            info.className = 'request-info';

            const name = document.createElement('h3');
            name.textContent = request.name;

            const description = document.createElement('p');
            description.textContent =
                `${request.direction} request: ${request.offeredSkill} ↔ ${request.requestedSkill}`;

            const direction = document.createElement('span');
            direction.textContent = request.direction;

            info.appendChild(name);
            info.appendChild(description);
            info.appendChild(direction);

            const status = document.createElement('span');
            const statusClass = request.status.toLowerCase();

            status.className = `status ${statusClass}`;
            status.textContent = request.status;

            item.appendChild(avatar);
            item.appendChild(info);
            item.appendChild(status);

            requestsList.appendChild(item);
        });

    } catch (error) {
        console.error('Recent requests error:', error);
        requestsList.innerHTML =
            '<p>Could not load recent requests. Please try again.</p>';
    }
}

    loadDashboardStats();
    loadDashboardSkills();
    loadRecentRequests();
</script>

