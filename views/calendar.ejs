
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Calendar | SkillSwap</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <main class="calendar-container">
        <h1>My Calendar</h1>
        <p>View your scheduled skill exchange sessions.</p>

        
<div class="calendar-actions">
    <button type="button" onclick="loadSessions()">Refresh Sessions</button>
    <a href="/dashboard">Back to Dashboard</a>
</div>

<section class="session-card">
    <h2>Schedule a Session</h2>
    <p>Arrange a time to exchange skills with another student.</p>

    <form id="scheduleSessionForm">
        <label for="requestId">Accepted Exchange Request</label>
        <select id="requestId" name="requestId" required>
            <option value="">Loading accepted requests...</option>
        </select>

        <p>
            <label for="sessionTitle">Session Title</label><br>
            <input
                type="text"
                id="sessionTitle"
                name="title"
                placeholder="e.g. Data Analysis Practice"
                required
            >
        </p>

        <p>
            <label for="sessionDescription">Description</label><br>
            <textarea
                id="sessionDescription"
                name="description"
                placeholder="What will you learn or practise?"
            ></textarea>
        </p>

        <p>
            <label for="sessionDate">Date</label><br>
            <input type="date" id="sessionDate" name="sessionDate" required>
        </p>

        <p>
            <label for="startTime">Start Time</label><br>
            <input type="time" id="startTime" name="startTime" required>
        </p>

        <p>
            <label for="endTime">End Time</label><br>
            <input type="time" id="endTime" name="endTime" required>
        </p>

        <button type="submit">Schedule Session</button>
        <p id="scheduleMessage" role="status"></p>
    </form>
</section>


